# Copy to .env.local and fill in values (never commit .env.local)

# xAI / Grok (same as BloomGuard)
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
BOTANICHELP_MODEL=grok-4.5

# Supabase Auth
# Prefer the classic anon JWT (eyJ...) from Project Settings → API
# if the new sb_publishable_ key fails with the JS client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: service role for Stripe webhooks to write botanic_plan on the user
# (Project Settings → API → service_role). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (TEST mode first — keys start with pk_test_ / sk_test_) ──────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Products → create two recurring monthly Prices (EUR):
#   Huerto     9,99 €/mes  → copy Price ID (price_...)
#   Ilimitado 19,99 €/mes  → copy Price ID (price_...)
STRIPE_PRICE_HUERTO=price_xxxxxxxx
STRIPE_PRICE_ILIMITADO=price_xxxxxxxx

# Webhooks (Developers → Webhooks → Add endpoint)
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Public site URL (success/cancel redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
